ExecStart=/data/byron/dio-wsl-restored-20261015/home/byron/DIO-Full-Audit/.venv/bin/python -u /data/byron/dio-wsl-restored-20261015/home/byron/DIO-Full-Audit/scripts/serve_pictora_image_editor.py --host 127.0.0.1 --port 42153
