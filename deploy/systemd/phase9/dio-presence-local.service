[Unit]
Description=DIO Phase 9 local Presence Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/DIO-Full-Audit
EnvironmentFile=-%h/.config/dio/sovereign.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/DIO-Full-Audit/.venv/bin/python %h/DIO-Full-Audit/scripts/serve_presence_bridge.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
