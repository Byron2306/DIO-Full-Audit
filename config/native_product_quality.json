{
  "schema": "dio.native_product_quality_contract.v1",
  "policy": {
    "native_identity_must_match": true,
    "surrogate_fallback_allowed": false,
    "artifact_quality_required_before_site_promotion": true,
    "commercial_validation": "UNPROVED",
    "external_release": "REFUSE",
    "human_release": "NEEDS_YOU"
  },
  "products": {
    "HOMS Exam": {
      "route": "homs_raw_exam",
      "native_engine": "scripts.run_hymark_history_source_first.run_builder",
      "native_receipt_schema": "knowedge.hymark_exam_builder_receipt.v1",
      "required_outputs": [
        "first_exam",
        "first_memo",
        "second_exam",
        "second_memo",
        "review_zip"
      ],
      "minimum_bytes": {
        "first_exam": 20000,
        "first_memo": 20000,
        "second_exam": 20000,
        "second_memo": 20000,
        "review_zip": 30000
      },
      "minimum_words": {
        "first_exam": 700,
        "first_memo": 450,
        "second_exam": 700,
        "second_memo": 450
      },
      "exam_signal_groups": [
        ["source", "sources"],
        ["question", "questions"],
        ["mark", "marks"]
      ],
      "memo_signal_groups": [
        ["memorandum", "memo", "marking guide"],
        ["mark", "marks"],
        ["answer", "response", "credit", "award"]
      ],
      "require_distinct_opportunities": true,
      "customer_source_booklet_required": true,
      "invented_source_provenance_allowed": false,
      "described_missing_visual_allowed": false
    },
    "VAMP Performance": {
      "route": "vamp_raw_performance",
      "native_engine": "adapters.vamp.snapshot_pipeline.build_snapshot",
      "native_binding_schema": "dio.professional_evidence.vamp_native_binding.v1",
      "required_artifacts": [
        "VAMP_SNAPSHOT.json",
        "VAMP_SNAPSHOT.md",
        "EVIDENCE_LEDGER.json",
        "OBJECTIVE_COVERAGE.json",
        "VAMP_SNAPSHOT_RECEIPT.json"
      ],
      "minimum_metrics": {
        "objectives_total": 3,
        "evidence_records": 6,
        "accepted_mappings": 2
      },
      "require_candidate_partial_or_gap": true,
      "minimum_summary_words": 120,
      "summary_signal_groups": [
        ["coverage", "evidence-backed"],
        ["candidate", "gaps", "gap", "partial"],
        ["human review", "review"]
      ],
      "rating_must_remain_disabled": true,
      "employment_decision_must_remain_absent": true
    },
    "Evidex EvidenceOps": {
      "route": "evidex_raw",
      "native_engine": "scripts.run_evidex_jobs.run_evidex",
      "native_binding_schema": "dio.professional_evidence.evidex_native_binding.v1",
      "minimum_customer_source_count": 10,
      "minimum_output_file_count": 3,
      "minimum_output_total_bytes": 12000,
      "minimum_extractable_words": 650,
      "output_signal_groups": [
        ["evidence", "source", "provenance"],
        ["claim", "claims"],
        ["gap", "gaps", "missing", "unsupported"],
        ["12", "fourteen", "14"]
      ],
      "contradiction_must_be_preserved": true
    },
    "DossierOps": {
      "route": "dossierops_raw_composition",
      "native_engine": "products.dossierops_native_pilot.run_dossierops_native_pilot",
      "native_binding_schema": "dio.professional_evidence.dossierops_native_binding.v1",
      "minimum_customer_source_count": 5,
      "minimum_open_question_count": 3,
      "minimum_review_brief_words": 700,
      "minimum_document_studio_rendered_artifacts": 3,
      "minimum_bundle_bytes": 20000,
      "minimum_native_output_total_bytes": 50000,
      "review_brief_signal_groups": [
        ["signed agreement", "signed record"],
        ["unsigned amendment", "unsigned draft"],
        ["R426,000", "426,000"],
        ["agreed in principle", "agreement-in-principle"],
        ["open question", "open questions", "gap"],
        ["human review", "NEEDS_YOU"],
        ["legal sufficiency", "enforceability", "legal conclusion"]
      ],
      "document_studio_execution_required": true,
      "signed_unsigned_distinction_required": true,
      "forbidden_authority_outcomes": [
        "dossier_completeness_certified",
        "legal_sufficiency_determined",
        "record_authenticity_attested",
        "retention_disposal_authorized",
        "external_submission_performed",
        "final_release_performed",
        "unsigned_amendment_promoted_to_executed"
      ],
      "identity_state_required": "controlled_pilot_unpromoted",
      "canonical_portfolio_registration_required": false
    }
  }
}
