{
  "name": "dio-edge-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler deploy --dry-run",
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:live": "wrangler deploy --env live",
    "db:local": "wrangler d1 migrations apply DIO_DB --local",
    "db:remote": "wrangler d1 migrations apply DIO_DB --remote",
    "db:live": "wrangler d1 migrations apply DIO_DB --remote --env live"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  }
}
