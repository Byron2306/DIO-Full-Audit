{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.meta_runtime.receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtime_version", "runtime_entrypoint", "product_id", "evaluated_at", "plan_fingerprint", "step_receipts", "input_immutable", "authority_created", "executor_created", "external_effects", "external_release_authorized", "human_gate", "external_release_gate", "runtime_fingerprint"],
  "properties": {
    "schema": {"const": "dio.meta_runtime.receipt.v1"},
    "runtime_version": {"const": "1.0.0"},
    "runtime_entrypoint": {"const": "products/meta_runtime.py"},
    "product_id": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "minLength": 1},
    "plan_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "step_receipts": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "input_immutable": {"const": true},
    "authority_created": {"const": false},
    "executor_created": {"const": false},
    "external_effects": {"const": false},
    "external_release_authorized": {"const": false},
    "human_gate": {"const": "NEEDS_YOU"},
    "external_release_gate": {"const": "REFUSE"},
    "runtime_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
