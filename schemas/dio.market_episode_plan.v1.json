{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.market_episode_plan.v1",
  "title": "DIO Market Episode Plan v1",
  "type": "object",
  "required": [
    "schema", "episode_id", "product_id", "context_digest", "projection_digest",
    "offer_state_digest", "channel_state_digest", "pricing_state_digest",
    "authority_preflight_digest", "market_command_plan_digest",
    "observation_contract_digest", "campaign_id", "buyer_segment_id", "channel_id",
    "offer_id", "currency", "price_minor", "measurement_window_seconds",
    "release_state", "observation_kinds", "market_response_observed",
    "activation_performed", "seraph_operational_gate_executed", "authority_created",
    "external_effects", "plan_digest"
  ],
  "properties": {
    "schema": {"const": "dio.market_episode_plan.v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "offer_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "channel_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pricing_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_preflight_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "market_command_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "minLength": 1},
    "buyer_segment_id": {"type": "string", "minLength": 1},
    "channel_id": {"type": "string", "minLength": 1},
    "offer_id": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "price_minor": {"type": "integer", "minimum": 0},
    "measurement_window_seconds": {"type": "integer", "minimum": 1},
    "release_state": {"const": "HELD_FOR_AUTHORITY"},
    "observation_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "market_response_observed": {"const": false},
    "activation_performed": {"const": false},
    "seraph_operational_gate_executed": {"const": false},
    "authority_created": {"const": false},
    "external_effects": {"const": false},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
