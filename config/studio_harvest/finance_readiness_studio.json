    "venture": {
      "name": "Karoo Field Analytics",
      "business_model": "Field-data and research support services for agricultural and environmental projects.",
      "funding_need": "R350,000 equipment and working-capital facility",
      "use_of_funds": ["field equipment", "laptop and data-capture hardware", "three months working capital"]
    },
    "published_requirements_fixture": [
      {"requirement_id": "FR-01", "label": "business registration evidence", "mandatory": true},
      {"requirement_id": "FR-02", "label": "recent bank statements", "mandatory": true},
      {"requirement_id": "FR-03", "label": "management accounts or financial statements", "mandatory": true},
      {"requirement_id": "FR-04", "label": "use-of-funds breakdown", "mandatory": true},
      {"requirement_id": "FR-05", "label": "repayment or cash-flow assumptions", "mandatory": true}
    ],
    "supplied_evidence_fixture": [
      {"evidence_id": "EV-01", "supports": ["FR-01"], "label": "company registration record", "state": "supplied"},
      {"evidence_id": "EV-02", "supports": ["FR-02"], "label": "three months bank statements", "state": "supplied"},
      {"evidence_id": "EV-03", "supports": ["FR-04"], "label": "equipment quotations and use-of-funds schedule", "state": "supplied"}
    ],
    "assumptions": [
      "Projected monthly revenue grows after equipment acquisition.",
      "Working-capital requirement is limited to three months.",
      "No lender approval, affordability or underwriting outcome is known."
    ],
    "forbidden_claims": [
      "guaranteed finance approval",
      "guaranteed affordability",
      "lender underwriting score",
      "credit bureau conclusion",
      "regulated investment or financial advice"
