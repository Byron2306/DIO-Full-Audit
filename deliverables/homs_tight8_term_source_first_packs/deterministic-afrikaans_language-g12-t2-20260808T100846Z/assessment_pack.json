      "title": "Afdeling A: Begrip En Visuele Geletterdheid",
      "mode": "source_response",
      "instructions": "Lees die bron- en visuele stimulus noukeurig en beantwoord die vrae in Afrikaans.",
      "stimulus": "Bronstel oor literere uittreksel, karakter, tema en taalontleding en visuele geletterdheid en media-boodskapinterpretasie. Die opvoeder voeg die goedgekeurde teks, spotprent, advertensie of infografika by.",
      "questions": [
        {
          "number": "1.1",
          "question": "Identifiseer die hoofgedagte van die teks en haal EEN bewys uit die bron aan.",
          "marks": 4,
          "memo": [
            "Hoofgedagte korrek.",
            "Bewys uit die bron pas by die hoofgedagte."
          ]
        },
        {
          "number": "1.2",
          "question": "Verduidelik hoe toon en register die teikengroep beinvloed.",
          "marks": 6,
          "memo": [
            "Verwys na toon.",
            "Verwys na register.",
            "Koppel aan teikengroep."
          ]
        },
        {
          "number": "1.3",
          "question": "Ontleed die visuele boodskap en verduidelik hoe beeld en woorde saam betekenis skep.",
          "marks": 8,
          "memo": [
            "Noem visuele tegniek.",
            "Noem taalkeuse.",
            "Verduidelik gesamentlike effek."
          ]
        },
        {
          "number": "1.4",
          "question": "Skryf 'n kort opsomming van die kerninligting in 60-80 woorde.",
          "marks": 7,
          "memo": [
            "Kernpunte gekies.",
            "Geen onnodige besonderhede.",
            "Woordtelling en eie woorde."
          ]
        }
      ]
    },
    {
      "title": "Afdeling B: Taal In Konteks",
      "mode": "language_structures",
      "instructions": "Gebruik die bronteks vir taalstruktuur- en redigeringsvrae.",
      "stimulus": "Taalfokus: aanhalingskeuse, bewysinvoeging en paragraafstruktuur.",
      "questions": [
        {
          "number": "2.1",
          "question": "Verbeter die gegewe sin deur woordkeuse, leestekens en register te korrigeer.",
          "marks": 5,
          "memo": [
            "Korrekte woordkeuse.",
            "Korrekte leestekens.",
            "Register bly gepas."
          ]
        },
        {
          "number": "2.2",
          "question": "Verduidelik die funksie van TWEE taalstrukture in die teks.",
          "marks": 5,
          "memo": [
            "Twee strukture genoem.",
            "Funksies akkuraat verduidelik."
          ]
        },
        {
          "number": "2.3",
          "question": "Herskryf 'n sin in 'n meer formele register sonder om die betekenis te verander.",
          "marks": 5,
          "memo": [
            "Betekenis behou.",
            "Formele register konsekwent."
          ]
        }
      ]
    },
    {
      "title": "Afdeling C: Skryfrespons",
      "mode": "writing_response",
      "instructions": "Beplan en skryf 'n gestruktureerde respons.",
