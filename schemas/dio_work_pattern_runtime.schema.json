{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.work_pattern_runtime.registry.v1",
  "title": "DIO Work Pattern Runtime Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtime_version", "constitution_version", "laws", "focus_patterns", "contracts"],
  "properties": {
    "schema": {"const": "dio.work_pattern_runtime.registry.v1"},
    "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "constitution_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts_request_capabilities_not_providers",
        "contracts_create_authority",
        "contracts_create_executors",
        "runtime_executes_side_effects",
        "human_boundaries_are_inherited",
        "provider_applicability_remains_product_scoped"
      ],
      "properties": {
        "contracts_request_capabilities_not_providers": {"const": true},
        "contracts_create_authority": {"const": false},
        "contracts_create_executors": {"const": false},
        "runtime_executes_side_effects": {"const": false},
        "human_boundaries_are_inherited": {"const": true},
        "provider_applicability_remains_product_scoped": {"const": true}
      }
    },
    "focus_patterns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["WP01", "WP05", "WP08", "WP10", "WP11"]}
    },
    "contracts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_pattern_id",
        "contract_id",
        "contract_version",
        "runtime_stage",
        "input_contract",
        "output_contract",
        "human_boundary",
        "operations"
      ],
      "properties": {
        "work_pattern_id": {"type": "string", "pattern": "^WP(0[1-9]|1[0-2])$"},
        "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.v[0-9]+$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime_stage": {"enum": ["v1_focus", "declared"]},
        "input_contract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "output_contract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "human_boundary": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "capability_id", "required", "execution_required"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "required": {"const": true},
        "execution_required": {"const": false}
      }
    }
  }
}
