          "target_text": "Inqubo Yokuqapha Ikhwalithi Yamanzi Okuphuza Emphakathini",
          "target_hash": "sha256:759b2a115d71a376e76eb36c43af0c7cafa6b8b5cc3a20bca8fe62d738d82c5b",
          "status": "human_approved_crystallized",
          "provider": "nvidia_nim",
          "model": "deepseek-ai/deepseek-v4-flash-0731",
          "critic_changed": false,
