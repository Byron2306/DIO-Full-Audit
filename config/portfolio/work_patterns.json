  "work_patterns": [
    {"id":"WP01","slug":"evidence","name":"Evidence work","canonical_transformation":"requirement -> supporting evidence -> sufficiency/gaps","primary_meta":["meta_evidence","meta_room"],"human_boundary":"human accepts evidence","automation_risk":"LOW_MEDIUM","reusable_engines":["Evidex","VAMP","Governed Case"]},
    {"id":"WP02","slug":"integrity","name":"Integrity work","canonical_transformation":"claim -> source -> warrant/limitation -> contradiction","primary_meta":["meta_evidence","meta_assurance","meta_room"],"human_boundary":"author/reviewer disposes claim","automation_risk":"MEDIUM","reusable_engines":["Sophia","Seraph"]},
    {"id":"WP03","slug":"achievement","name":"Achievement work","canonical_transformation":"objective/framework -> activity/evidence -> coverage/gaps","primary_meta":["meta_evidence","meta_room"],"human_boundary":"reviewer judges achievement","automation_risk":"MEDIUM","reusable_engines":["VAMP","Evidex"]},
    {"id":"WP04","slug":"quality","name":"Quality work","canonical_transformation":"rule/standard -> implementation evidence -> nonconformance/gap","primary_meta":["meta_evidence","meta_assurance","meta_room"],"human_boundary":"quality owner acts","automation_risk":"MEDIUM","reusable_engines":["VAMP","Evidex","Seraph"]},
    {"id":"WP05","slug":"obligation","name":"Obligation work","canonical_transformation":"contract/grant/policy -> obligation/deadline -> evidence/status","primary_meta":["meta_evidence","meta_assurance","meta_authority","meta_room"],"human_boundary":"owner decides fulfilment/escalation","automation_risk":"MEDIUM_HIGH","reusable_engines":["Legalis","Evidex","VAMP"]},
    {"id":"WP06","slug":"assessment","name":"Assessment work","canonical_transformation":"curriculum/framework -> assessment artefact -> judgement/moderation","primary_meta":["meta_evidence","meta_assurance","meta_room"],"human_boundary":"educator/examiner owns marks/release","automation_risk":"MEDIUM","reusable_engines":["HOMS","Sophia"]},
    {"id":"WP07","slug":"assurance","name":"Assurance work","canonical_transformation":"expected state -> actual state -> drift/challenge -> reassessment","primary_meta":["meta_assurance","meta_room"],"human_boundary":"operator/risk owner decides response","automation_risk":"HIGH","reusable_engines":["Seraph","BEAST","Twin"]},
    {"id":"WP08","slug":"intake","name":"Intake work","canonical_transformation":"messy inbound communication -> classified governed case -> missing info","primary_meta":["meta_evidence","meta_authority"],"human_boundary":"human controls side effects","automation_risk":"MEDIUM","reusable_engines":["Vesper","Outlook/Graph"]},
    {"id":"WP09","slug":"authority","name":"Authority work","canonical_transformation":"proposed action -> prerequisites -> human authority -> bounded execution","primary_meta":["meta_authority","meta_assurance","meta_room"],"human_boundary":"explicit human + Valinor + ARDA","automation_risk":"VERY_HIGH","reusable_engines":["Valinor","ARDA","Legalis"]},
    {"id":"WP10","slug":"document","name":"Document work","canonical_transformation":"approved meaning -> edit/translate/project -> QA -> release","primary_meta":["meta_evidence","meta_assurance","meta_room"],"human_boundary":"qualified editor/reviewer/client","automation_risk":"MEDIUM","reusable_engines":["Document Studio","Lingua","Format Core"]},
    {"id":"WP11","slug":"proof","name":"Proof work","canonical_transformation":"governed case/history -> portable evidence package -> integrity verification","primary_meta":["meta_room","meta_assurance"],"human_boundary":"authorised owner controls disclosure","automation_risk":"LOW_MEDIUM","reusable_engines":["Room","Format Core"]},
    {"id":"WP12","slug":"market","name":"Market work","canonical_transformation":"signal -> hypothesis -> bounded experiment -> measured outcome -> learning","primary_meta":["meta_evidence","meta_assurance","meta_authority"],"human_boundary":"operator controls publishing/spend/outreach","automation_risk":"MEDIUM","reusable_engines":["NicheFoundry","Hivenance","Market Command"]}
