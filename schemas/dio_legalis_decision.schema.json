{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dio.local/schemas/dio_legalis_decision.schema.json",
  "title": "DIO Legalis Decision Receipt",
  "type": "object",
  "required": ["schema", "decision_id", "capability_id", "verdict", "configured_prerequisites_satisfied", "legal_clearance", "legal_opinion", "requirement_results", "identity_snapshot_sha256", "requirement_registry_sha256", "evaluated_at", "kernel_authority", "kernel_enforcement_performed", "boundary_statement"],
  "properties": {
    "schema": {"const": "dio.legalis.decision_receipt.v1"},
    "decision_id": {"type": "string", "minLength": 8},
    "capability_id": {"type": "string", "minLength": 1},
    "capability_description": {"type": ["string", "null"]},
    "verdict": {"enum": ["ALLOW", "REFUSE", "NEEDS_YOU"]},
    "configured_prerequisites_satisfied": {"type": "boolean"},
    "legal_clearance": {"const": false},
    "legal_opinion": {"const": false},
    "automatic_waiver": {"const": false},
    "automatic_filing": {"const": false},
    "human_or_professional_decision_may_still_be_required": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "requirement_results": {"type": "array", "items": {"type": "object"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "operator_receipt_refs": {"type": "array", "items": {"type": "string"}},
    "identity_id": {"type": "string"},
    "identity_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requirement_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operator_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "kernel_authority": {"const": "Valinor"},
    "kernel_enforcement_performed": {"const": false},
    "boundary_statement": {"type": "string", "minLength": 20}
  },
  "additionalProperties": false
}
