{
  "schema": "knowedge.shared_media_layers.v2",
  "layers": [
    {
      "id": "nichefoundry_media",
      "name": "NicheFoundry Media + Transformation Layer",
      "commercial_role": "shared_infrastructure_not_standalone_offer",
      "purpose": "Turn approved product proof and curriculum content into faceless media, and perform governed image conversion and video editing without weakening source, rights, review, or release boundaries.",
      "capabilities": {
        "generation": [
          "campaign key art",
          "faceless proof short",
          "thumbnail",
          "captioned explainer",
          "curriculum-linked video lesson"
        ],
        "image_transformation": [
          "format conversion",
          "resize",
          "contain or cover fitting",
          "crop through bounded fit policy",
          "rotate",
          "flip",
          "quality/compression selection",
          "metadata stripping"
        ],
        "video_editing": [
          "trim",
          "concatenate",
          "resize and aspect-ratio adaptation",
          "transcode",
          "frame-rate normalization",
          "mute",
          "audio replacement",
          "audio gain adjustment",
          "subtitle burn-in",
          "bounded image/logo overlay"
        ]
      },
      "inputs": [
        "approved product proof or owner-authorised source media",
        "source and rights ledger",
        "operator-approved script or transformation request",
        "product claim boundaries when marketing content is involved",
        "channel and audience brief when publication is intended"
      ],
      "outputs": [
        "generated media asset",
        "converted image asset",
        "edited video asset",
        "source hash",
        "operation plan hash",
        "output hash",
        "transformation receipt"
      ],
      "invariants": [
        "source assets are preserved by default",
        "arbitrary ffmpeg filter expressions are not accepted through the governed transformation contract",
        "output overwrite is refused by default",
        "conversion does not imply semantic editing or factual approval",
        "editing does not create publication authority",
        "rights and release gates survive format conversion and editing"
      ],
      "release_gates": [
        "proof approved when claims are present",
        "script and claims approved when applicable",
        "visual and music rights recorded",
        "voice and audio mix reviewed when applicable",
        "render or transformation quality checked",
        "publication explicitly released"
      ],
      "product_routes": {
        "homs": ["marking proof", "exam-studio proof", "educator workflow explainer"],
        "homs_learning": ["topic explainer", "extra-class lesson", "worksheet companion video"],
        "evidex": ["golden-case proof", "evidence workflow explainer"],
        "sophia": ["academic-integrity explainer", "review workflow proof"],
        "vamp": ["performance evidence proof", "objective-mapping explainer"],
        "document_studio": ["technical editing proof", "multilingual semantic-QA explainer", "document conversion companion media"],
        "portfolio": ["product explainer conversion", "social crop/versioning", "approved video repackaging"]
      }
    }
  ]
}
