  "laws": {
    "products_request_capabilities_not_organs": true,
    "compiler_resolves_providers": true,
    "planned_capability_is_not_earned_capability": true,
    "missing_required_execution_capability": "REFUSE",
    "provider_selection_is_deterministic": true,
    "provider_reference_must_exist_when_available": true,
    "provider_applicability_must_be_explicit": true,
    "regulatory_source_authority_must_be_explicit": true,
    "regulatory_source_version_and_effective_interval_must_be_retained": true,
    "applicability_uncertainty": "NEEDS_YOU",
    "draft_is_not_filing": true,
    "regulatory_filing_requires_external_human_authority": true,
    "self_expansion_requires_closed_declarative_spec": true,
    "self_expansion_must_use_canonical_compiler": true,
    "generated_profiles_must_be_source_and_hash_bound": true,
    "generated_provider_scope_must_be_exact": true,
    "generation_must_not_promote_maturity": true,
    "generation_must_not_create_external_authority": true,
    "marketfront_generation_is_not_publication": true,
    "engine_binding_is_not_engine_execution": true,
    "generated_media_is_draft_only": true,
    "generated_storefront_payment_defaults_to_refuse": true,
    "commercial_measurement_does_not_create_market_truth": true
  },
