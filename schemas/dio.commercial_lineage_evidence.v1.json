{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.commercial_lineage_evidence.v1",
  "title": "DIO Commercial Lineage Evidence v1",
  "type": "object",
  "required": [
    "schema",
    "scenario_id",
    "context_digest",
    "customer_lineage_digest",
    "payment_lineage_digest",
    "artifact_digest",
    "observation_digests",
    "customer_independence",
    "payment_state",
    "payment_verified_in_controlled_fixture",
    "customer_acceptance_observed_in_controlled_fixture",
    "structural_wtp_gate_satisfied",
    "real_market_evidence",
    "willingness_to_pay_proved",
    "commercial_validation_proved",
    "repeatability_proved",
    "authority_created",
    "external_effects",
    "truth_digest"
  ],
  "properties": {
    "schema": {"const": "dio.commercial_lineage_evidence.v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "customer_lineage_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payment_lineage_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "observation_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "customer_independence": {"enum": ["UNKNOWN", "OPERATOR_SELF", "RELATED", "INDEPENDENT_EXTERNAL"]},
    "payment_state": {"enum": ["UNKNOWN", "PENDING", "VERIFIED", "FAILED", "REFUNDED", "DISPUTED"]},
    "payment_verified_in_controlled_fixture": {"type": "boolean"},
    "customer_acceptance_observed_in_controlled_fixture": {"type": "boolean"},
    "structural_wtp_gate_satisfied": {"type": "boolean"},
    "real_market_evidence": {"const": false},
    "willingness_to_pay_proved": {"const": false},
    "commercial_validation_proved": {"const": false},
    "repeatability_proved": {"const": false},
    "authority_created": {"const": false},
    "external_effects": {"const": false},
    "truth_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
