{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIO VAMP Commercial Snapshot Request",
  "type": "object",
  "required": ["job_id", "customer", "profile_path", "source", "review", "privacy_mode", "consents"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"},
    "customer": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 120},
        "email": {"type": "string", "format": "email"},
        "organization": {"type": "string", "maxLength": 160}
      },
      "additionalProperties": false
    },
    "profile_path": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["kind", "database_path", "staff_id", "year"],
      "properties": {
        "kind": {"const": "vamp_sqlite"},
        "database_path": {"type": "string", "minLength": 1},
        "staff_id": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 2000, "maximum": 2200}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["months"],
      "properties": {
        "months": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}
        }
      },
      "additionalProperties": false
    },
    "privacy_mode": {"enum": ["private_internal", "redacted_demo"]},
    "consents": {
      "type": "object",
      "required": ["evidence_owner_authorized", "performance_data_processing_approved", "human_review_terms_accepted"],
      "properties": {
        "evidence_owner_authorized": {"const": true},
        "performance_data_processing_approved": {"const": true},
        "human_review_terms_accepted": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
