{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.product_explainer.v1",
  "type": "object",
  "required": [
    "schema",
    "product_id",
    "source_binding",
    "explanation",
    "outputs",
    "proof_points",
    "claims",
    "canonical_story",
    "target_seconds",
    "authority"
  ],
  "properties": {
    "schema": {"const": "dio.product_explainer.v1"},
    "product_id": {"type": "string", "minLength": 1},
    "source_binding": {"type": "object"},
    "explanation": {
      "type": "object",
      "required": ["what_it_is", "problem", "how_it_works", "why_different", "buyer_result"],
      "properties": {
        "what_it_is": {"type": "string"},
        "problem": {"type": "string"},
        "how_it_works": {"type": "string"},
        "why_different": {"type": "string"},
        "buyer_result": {"type": "string"}
      },
      "additionalProperties": true
    },
    "outputs": {"type": "array"},
    "proof_points": {"type": "array"},
    "claims": {
      "type": "object",
      "required": ["allowed", "qualified", "forbidden"],
      "properties": {
        "allowed": {"type": "array"},
        "qualified": {"type": "array"},
        "forbidden": {"type": "array"}
      },
      "additionalProperties": true
    },
    "canonical_story": {"type": "array", "minItems": 1},
    "target_seconds": {"type": "number", "minimum": 1},
    "authority": {
      "type": "object",
      "required": ["semantic_truth_source", "market_may_change_product_truth", "human_release_required"],
      "properties": {
        "semantic_truth_source": {"type": "string", "minLength": 1},
        "market_may_change_product_truth": {"const": false},
        "human_release_required": {"const": true},
        "external_publication": {"enum": ["NEEDS_YOU", "REFUSE"]},
        "media_spend": {"const": "REFUSE"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
