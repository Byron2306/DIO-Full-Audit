      "questions": [
        {
          "number": "3.1",
          "question": "Skryf 'n beplande transaksionele teks met gepaste struktuur, register en doel.",
          "marks": 10,
          "memo": [
            "Struktuur pas by tekssoort.",
            "Register en doel is duidelik.",
            "Inhoud is samehangend."
          ]
        }
      ]
    }
