# DIO Phase 9 sovereign local runtime
# Copy to ~/.config/dio/sovereign.env and chmod 600.
# Never commit real tokens or secrets.

# Ollama is the only active LLM provider.
DIO_PRESENCE_LLM_PROVIDER=ollama
DIO_PRESENCE_LLM_DRAFTS=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=60

# Presence secrets remain local and must be >= 32 characters.
DIO_PRESENCE_OPERATOR_SHARED_SECRET=REPLACE_LOCAL_SECRET
DIO_PRESENCE_PUBLIC_SHARED_SECRET=REPLACE_LOCAL_SECRET
DIO_PRESENCE_IDENTITY_SALT=REPLACE_LOCAL_SALT
DIO_PRESENCE_OPERATOR_TOKEN=REPLACE_LOCAL_OPERATOR_TOKEN

# Telegram Bot API. Long polling means no inbound webhook is required.
DIO_TELEGRAM_OPERATOR_BOT_TOKEN=REPLACE_TELEGRAM_OPERATOR_TOKEN
DIO_TELEGRAM_PUBLIC_BOT_TOKEN=
DIO_OPERATOR_TELEGRAM_IDS=REPLACE_OPERATOR_TELEGRAM_ID
DIO_PRESENCE_PUBLIC_TELEGRAM_REPLIES=0
DIO_PRESENCE_OPERATOR_TELEGRAM_REPLIES=1

# Microsoft Graph uses the existing local MSAL token cache and config file.
# No Graph webhook secret is required by the delta-poll runtime.

# PayPal credentials are kept on the DIO host, not Cloudflare.
PAYPAL_CLIENT_ID=REPLACE_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_PAYPAL_CLIENT_SECRET
PAYPAL_ENV=sandbox
DIO_PAYPAL_RETURN_URL=https://REPLACE_STATIC_RETURN_PAGE
DIO_PAYPAL_CANCEL_URL=https://REPLACE_STATIC_CANCEL_PAGE
