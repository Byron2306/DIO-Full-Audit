      "operations": [
        {"operation_id": "materialize_case", "capability_id": "case.materialize", "required": true, "execution_required": false},
        {"operation_id": "capture_provenance", "capability_id": "evidence.provenance", "required": true, "execution_required": false},
        {"operation_id": "map_evidence", "capability_id": "evidence.link", "required": true, "execution_required": false},
