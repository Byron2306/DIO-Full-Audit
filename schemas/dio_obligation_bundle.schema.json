{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dio.local/schemas/dio_obligation_bundle.schema.json",
  "title": "DIO Obligation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "source",
    "canonical_states",
    "obligations",
    "deadlines",
    "evidence_bindings",
    "evaluations",
    "human_gate",
    "authority_created",
    "executor_created",
    "external_effects",
    "fingerprint"
  ],
  "properties": {
    "schema": {"const": "dio.obligation_bundle.v1"},
    "engine_version": {"const": "0.1.0"},
    "source": {"$ref": "#/$defs/sourceMeta"},
    "canonical_states": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["SATISFIED", "PARTIAL", "MISSING", "CONTESTED", "EXPIRED", "NOT_YET_DUE", "NEEDS_REVIEW"]}
    },
    "obligations": {
      "type": "array",
      "items": {"$ref": "#/$defs/obligation"}
    },
    "deadlines": {
      "type": "array",
      "items": {"$ref": "#/$defs/deadline"}
    },
    "evidence_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceBinding"}
    },
    "evaluations": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "NEEDS_YOU"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "authority_created": {"const": false},
    "executor_created": {"const": false},
    "external_effects": {"const": false},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "source_ref", "sha256", "effective_at", "expires_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["contract", "grant", "policy", "permit", "tender", "standard", "other"]},
        "source_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]}
      }
    },
    "obligationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_ref", "sha256", "locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "source",
        "statement",
        "raw_text",
        "kind",
        "responsible_party",
        "due_at",
        "expires_at",
        "dependency_refs",
        "evidence_requirements",
        "authority_requirement",
        "extraction_basis",
        "review_required",
        "evidence_binding_ids",
        "status",
        "status_basis"
      ],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^OBL-[0-9A-F]{16}$"},
        "source": {"$ref": "#/$defs/obligationSource"},
        "statement": {"type": "string", "minLength": 1},
        "raw_text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["deliverable", "payment", "reporting", "notification", "approval_prerequisite", "maintenance", "retention", "access", "other"]},
        "responsible_party": {"type": ["string", "null"]},
        "due_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]},
        "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority_requirement": {"type": ["string", "null"]},
        "extraction_basis": {"enum": ["explicit_structured_obligation", "deontic_candidate"]},
        "review_required": {"type": "boolean"},
        "evidence_binding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^OBIND-[0-9A-F]{16}$"}},
        "status": {"enum": ["SATISFIED", "PARTIAL", "MISSING", "CONTESTED", "EXPIRED", "NOT_YET_DUE", "NEEDS_REVIEW"]},
        "status_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_id", "obligation_id", "kind", "due_at", "state"],
      "properties": {
        "deadline_id": {"type": "string", "pattern": "^ODEAD-[0-9A-F]{16}$"},
        "obligation_id": {"type": "string", "pattern": "^OBL-[0-9A-F]{16}$"},
        "kind": {"enum": ["response", "expiry"]},
        "due_at": {"type": "string", "minLength": 1},
        "state": {"enum": ["open", "due", "overdue", "expired"]}
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "obligation_id", "evidence_id", "evidence_kind", "source_ref", "relation", "trust_state", "freshness_state"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^OBIND-[0-9A-F]{16}$"},
        "obligation_id": {"type": "string", "pattern": "^OBL-[0-9A-F]{16}$"},
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_kind": {"type": "string", "minLength": 1},
        "source_ref": {"type": ["string", "null"]},
        "relation": {"enum": ["supports", "contradicts"]},
        "trust_state": {"enum": ["captured_untrusted", "trusted_for_review", "rejected", "quarantined"]},
        "freshness_state": {"enum": ["unknown", "current", "stale", "expired"]}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "status", "status_basis", "missing_evidence_requirements", "usable_evidence_ids", "contradicting_evidence_ids", "evaluated_at", "human_gate"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^OBL-[0-9A-F]{16}$"},
        "status": {"enum": ["SATISFIED", "PARTIAL", "MISSING", "CONTESTED", "EXPIRED", "NOT_YET_DUE", "NEEDS_REVIEW"]},
        "status_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "missing_evidence_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "usable_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contradicting_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evaluated_at": {"type": "string", "minLength": 1},
        "human_gate": {"const": "NEEDS_YOU"}
      }
    }
  }
}
