{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dio.example/schemas/fundingfinder-customer-opportunities-v1.json",
  "title": "FundingFinder customer opportunity input",
  "type": "object",
  "required": ["schema", "opportunities"],
  "properties": {
    "schema": {"const": "dio.fundingfinder.customer_opportunities.v1"},
    "title": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "fetch_public": {"type": "boolean", "default": false},
    "official_url_allowlist": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "applicant": {
      "type": "object",
      "required": ["name", "sources"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicantSource"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/applicantFact"}}
      },
      "additionalProperties": false
    },
    "applicant_facts": {"type": "array", "description": "Alternative to applicant.facts; each fact must quote a record_id from the evidence register."},
    "opportunities": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/opportunity"}}
  },
  "additionalProperties": false,
  "$defs": {
    "applicantSource": {
      "type": "object",
      "required": ["source_id", "text"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "applicantFact": {
      "type": "object",
      "required": ["field", "value", "source_id", "quote"],
      "properties": {"field": {"type": "string", "minLength": 1}, "value": {}, "source_id": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "opportunity": {
      "type": "object",
      "required": ["opportunity_id", "title", "funder", "official_url"],
      "properties": {
        "opportunity_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "funder": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "format": "uri"},
        "source": {"type": "object", "description": "For offline use, provide content or content_base64 and retrieved_at; public fetch uses the exact allowlisted URL."},
        "criteria": {"type": "array", "items": {"type": "object"}},
        "deadline": {"type": "object"},
        "opens": {"type": "object"},
        "rolling": {"type": "object"},
        "funding": {"type": "object"},
        "purpose": {"type": "object"},
        "stage": {"type": "object"},
        "required_documents": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  }
}
