{
  "schema_version": "arda.distribution.profile.v1",
  "distribution_id": "arda-valinor",
  "distribution_name": "ARDA Valinor",
  "base_distribution": {
    "family": "debian",
    "series": "trixie",
    "architecture": "amd64"
  },
  "artifacts": {
    "overlay_root": "arda_os/distribution/build/overlay",
    "manifest_output": "arda_os/distribution/releases/distribution-manifest.json",
    "installer_profile_output": "arda_os/distribution/releases/installer-profile.json",
    "remote_verifier_profile_output": "arda_os/distribution/releases/remote-verifier-profile.json",
    "iso_plan_output": "arda_os/distribution/releases/iso-build-plan.json",
    "image_artifact_plan_output": "arda_os/distribution/releases/image-artifact-plan.json",
    "installer_recipe_output": "arda_os/distribution/releases/installer-recipe.json",
    "release_bundle_output": "arda_os/distribution/releases/release-bundle.json"
  },
    "required_packages": [
        "bash",
        "coreutils",
        "curl",
        "dbus",
        "dbus-x11",
    "efibootmgr",
    "feh",
    "firefox-esr",
    "grub-efi-amd64",
        "initramfs-tools",
        "lightdm",
        "lightdm-gtk-greeter",
        "live-boot",
        "live-config",
        "mesa-utils",
        "mokutil",
    "plymouth",
    "plymouth-themes",
    "pipewire",
    "pipewire-audio",
    "pipewire-pulse",
    "pulseaudio-utils",
    "python3",
        "python3-cryptography",
        "python3-fastapi",
        "python3-uvicorn",
        "shim-signed",
        "sbsigntool",
        "spice-vdagent",
        "systemd",
        "systemd-boot-efi",
        "systemd-sysv",
    "systemd-ukify",
    "tpm2-tools",
    "wireplumber",
        "x11-xserver-utils",
        "xwallpaper",
        "xorg",
    "xserver-xorg-input-all",
    "xserver-xorg-video-all",
    "xfce4",
    "xfce4-terminal",
    "zstd"
  ],
  "systemd_units": [
    "arda-phase4-remote-verifier.service",
    "arda-valinor-boot-audit.service",
    "arda-valinor-postboot.service",
    "arda-bombadil-valinor.service"
  ],
  "overlay_rules": {
    "include_identity_assets": true,
    "include_boot_theme_assets": true,
    "include_policy_bundle": true,
    "include_verifier_env_template": true
  }
}
