{
  "schema": "dio.professional_intelligence_studio.v1",
  "studio_version": "1.0.0",
  "studio_id": "professional_correspondence_studio",
  "name": "DIO Professional Correspondence Studio",
  "job": {
    "buyer": "Professional services firm",
    "request": "I need a firm but professional reply to a client disputing an invoice.",
    "expected_route": "professional_correspondence_studio"
  },
  "required_organs": [
    {"engine_id": "lingua", "source_ref": "adapters/lingua/communicator.py", "capabilities": ["communication.meaning.register", "communication.render.bound"]},
    {"engine_id": "vesper", "source_ref": "presence_core/router.py", "capabilities": ["storefront.route.bind", "presence.release.prepare"]},
    {"engine_id": "outlook_mail_core", "source_ref": "scripts/manage_mail_intent.py", "capabilities": ["outlook.mail.draft.prepare"]},
    {"engine_id": "document_studio", "source_ref": "adapters/document_studio/pipeline.py", "capabilities": ["document.preview.render"]},
    {"engine_id": "evidex", "source_ref": "scripts/run_evidex_jobs.py", "capabilities": ["evidence.intake.structure"]},
    {"engine_id": "commercial_truth", "source_ref": "products/commercial_truth.py", "capabilities": ["commercial.claim.boundary"]}
  ],
  "authority": {
    "human_gate": "NEEDS_YOU",
    "external_publication": "REFUSE",
    "external_send": "REFUSE",
    "media_spend": "REFUSE",
    "payment": "REFUSE"
  },
  "artifact_contract": {
    "kind": "correspondence",
    "purpose": "Respond firmly and professionally to an invoice dispute while preserving factual and authority boundaries.",
    "tone": ["calm", "firm", "professional", "non-adversarial"],
    "must_preserve": ["the client has disputed the invoice", "the matter requires review", "no settlement has been authorised"],
    "must_not_invent": ["admission of fault", "waiver", "refund promise", "discount promise", "settlement agreement", "legal conclusion"],
    "draft": {
      "subject": "Re: Invoice query and review",
      "body_lines": [
        "Dear Client,",
        "Thank you for raising your concern regarding the invoice.",
        "We have noted the points you have raised and will review the relevant scope, records and billing basis before responding on the substance of the dispute.",
        "At this stage, this acknowledgement does not amend the invoice, concede liability, waive any rights, or create a settlement or refund commitment.",
        "Once the review is complete, an authorised person will respond with the appropriate next step.",
        "Kind regards,",
        "Professional Services Team"
      ]
    }
  }
}
