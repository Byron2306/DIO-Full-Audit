{
  "schema": "dio.secret_registry.v1",
  "secret_file": "secrets/dio.env",
  "rules": {
    "persist_values_in_git": false,
    "return_values_from_api": false,
    "file_mode": "0600",
    "localhost_operator_only": true
  },
  "providers": [
    {
      "id": "TIKTOK_ADS",
      "name": "TikTok Ads",
      "group": "marketing",
      "required": ["TIKTOK_ACCESS_TOKEN", "TIKTOK_ADVERTISER_ID"],
      "optional": ["TIKTOK_APP_ID", "TIKTOK_APP_SECRET", "TIKTOK_ACCOUNT_CURRENCY", "TIKTOK_API_BASE"],
      "authority": "reporting_only",
      "links": {
        "business": "https://business.tiktok.com/",
        "ads_manager": "https://ads.tiktok.com/"
      }
    },
    {
      "id": "TIKTOK_ORGANIC",
      "name": "TikTok Business Profile",
      "group": "marketing",
      "required": [],
      "optional": ["TIKTOK_CLIENT_KEY", "TIKTOK_CLIENT_SECRET", "TIKTOK_USER_ACCESS_TOKEN", "TIKTOK_OPEN_ID", "TIKTOK_REFRESH_TOKEN"],
      "authority": "human_publish_until_content_posting_api_approved",
      "links": {
        "developer": "https://developers.tiktok.com/",
        "profile": "https://www.tiktok.com/"
      }
    },
    {
      "id": "META_ADS",
      "name": "Meta Ads",
      "group": "marketing",
      "required": ["META_ACCESS_TOKEN", "META_AD_ACCOUNT_ID", "META_GRAPH_VERSION"],
      "optional": ["META_ACCOUNT_CURRENCY", "META_GRAPH_BASE"],
      "authority": "read_only_insights"
    },
    {
      "id": "FACEBOOK_PAGE",
      "name": "Facebook Page",
      "group": "marketing",
      "required": ["FACEBOOK_PAGE_ACCESS_TOKEN", "FACEBOOK_PAGE_ID", "META_GRAPH_VERSION"],
      "optional": [],
      "authority": "read_only_page_insights"
    },
    {
      "id": "INSTAGRAM_ORGANIC",
      "name": "Instagram Business",
      "group": "marketing",
      "required": ["META_ACCESS_TOKEN", "INSTAGRAM_BUSINESS_ACCOUNT_ID", "META_GRAPH_VERSION"],
      "optional": [],
      "authority": "read_only_media_insights"
    },
    {
      "id": "GOOGLE_ADS",
      "name": "Google Ads",
      "group": "marketing",
      "required": ["GOOGLE_ADS_CUSTOMER_ID", "GOOGLE_ADS_CREDENTIALS_FILE"],
      "optional": ["GOOGLE_ADS_ACCOUNT_CURRENCY"],
      "authority": "reporting_only"
    },
    {
      "id": "LINKEDIN_ORGANIC",
      "name": "LinkedIn Company",
      "group": "marketing",
      "required": ["LINKEDIN_ACCESS_TOKEN", "LINKEDIN_ORGANIZATION_URN", "LINKEDIN_VERSION"],
      "optional": [],
      "authority": "read_only_organization_analytics"
    },
    {
      "id": "YOUTUBE_ORGANIC",
      "name": "YouTube",
      "group": "marketing",
      "required": ["YOUTUBE_API_KEY", "YOUTUBE_CHANNEL_ID"],
      "optional": ["YOUTUBE_CLIENT_ID", "YOUTUBE_CLIENT_SECRET", "YOUTUBE_REFRESH_TOKEN"],
      "authority": "nichefoundry_operator_approval",
      "external_sources": ["/home/byron/Downloads/NicheFoundry_Phase11/.env"]
    },
    {
      "id": "NICHEFOUNDRY_LOCAL_MEDIA",
      "name": "NicheFoundry Local Media Runtime",
      "group": "local_media",
      "required": [],
      "optional": [
        "PIPER_BIN",
        "PIPER_MODEL",
        "PIPER_MODEL_DIR",
        "PIPER_MODEL_NAME",
        "PIPER_MODEL_FILE",
        "PIPER_CONFIG_FILE",
        "PIPER_VOICE",
        "DIO_CAMPAIGN_MUSIC",
        "DIO_CAMPAIGN_MUSIC_ATTRIBUTION"
      ],
      "authority": "local_generation_only_no_publication_authority",
      "external_sources": ["/home/byron/Downloads/NicheFoundry_Phase11/.env"]
    },
    {
      "id": "REDDIT_ADS",
      "name": "Reddit Ads",
      "group": "marketing",
      "required": ["REDDIT_ADS_ACCESS_TOKEN", "REDDIT_AD_ACCOUNT_ID", "REDDIT_USER_AGENT"],
      "optional": ["REDDIT_ADS_API_BASE"],
      "authority": "adsread_only"
    }
  ]
}
