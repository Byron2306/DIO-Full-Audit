[Unit]
Description=DIO broad weekly Capital and Support census expansion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/dio/control-deck
ExecStart=/usr/bin/python3 /srv/dio/control-deck/scripts/build_capital_support_census.py --root /srv/dio/control-deck --mode weekly --global --cycle-budget 1200
ExecStart=/usr/bin/python3 /srv/dio/control-deck/scripts/export_capital_support_census.py --root /srv/dio/control-deck
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
