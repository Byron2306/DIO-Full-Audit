{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.commercial_projection_adaptation_candidate.v1",
  "title": "DIO Commercial Projection Adaptation Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "product_id",
    "context_digest",
    "projection_config_digest",
    "market_truth_anchor_digests",
    "lingua_semantic_object_id",
    "lingua_source_document_hash",
    "held_market_claim_ids",
    "positive_reuse_state",
    "negative_learning_state",
    "operator_approval_required",
    "operator_approval_recorded",
    "real_market_evidence",
    "claim_upgrade_performed",
    "reusable_credit_created",
    "semantic_crystal_created",
    "direct_learning_to_execution",
    "authority_created",
    "external_effects",
    "candidate_digest"
  ],
  "properties": {
    "schema": {"const": "dio.commercial_projection_adaptation_candidate.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "market_truth_anchor_digests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "lingua_semantic_object_id": {"type": "string", "minLength": 1},
    "lingua_source_document_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "held_market_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "positive_reuse_state": {"const": "CONTROLLED_EVIDENCE_EXCLUDED_PENDING_REAL_EVIDENCE"},
    "negative_learning_state": {"const": "OBSERVING_CONTEXT_BOUND"},
    "operator_approval_required": {"const": true},
    "operator_approval_recorded": {"const": false},
    "real_market_evidence": {"const": false},
    "claim_upgrade_performed": {"const": false},
    "reusable_credit_created": {"const": false},
    "semantic_crystal_created": {"const": false},
    "direct_learning_to_execution": {"const": false},
    "authority_created": {"const": false},
    "external_effects": {"const": false},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
