{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dio.product_manifest.v1","title":"DIO Product Manifest","type":"object","additionalProperties":false,
  "required":["schema","manifest_version","product_id","name","incarnation","suite_ids","work_patterns","meta_capabilities","profiles","capability_requirements","executor_policy","maturity"],
  "properties":{
    "schema":{"const":"dio.product_manifest.v1"},"manifest_version":{"const":"1.0.0"},"product_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"name":{"type":"string","minLength":1},
    "incarnation":{"type":"object","additionalProperties":false,"required":["id","surface"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"surface":{"enum":["customer_facing","internal"]},"buyer_context":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "suite_ids":{"type":"array","items":{"enum":["education_research","evidence_assurance","public_programme_ops","ai_digital_trust","enterprise_operations","demand_presence"]},"uniqueItems":true},
    "work_patterns":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["WP01","WP02","WP03","WP04","WP05","WP06","WP07","WP08","WP09","WP10","WP11","WP12"]}},
    "meta_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["meta_evidence","meta_assurance","meta_authority","meta_room"]}},
    "profiles":{"type":"object","additionalProperties":false,"required":["domain","framework","authority","connector_pack","output","commercial"],"properties":{"domain":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}},"framework":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}},"authority":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}},"connector_pack":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}},"output":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}},"commercial":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/profileRef"}}}},
    "capability_requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["capability_id","required","execution_required"],"properties":{"capability_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"required":{"type":"boolean"},"execution_required":{"type":"boolean"}}}},
    "executor_policy":{"type":"object","additionalProperties":false,"required":["resolution","missing_required_executor"],"properties":{"resolution":{"const":"compiler"},"missing_required_executor":{"const":"REFUSE"}}},
    "maturity":{"type":"object","additionalProperties":false,"required":["state","operational_flags"],"properties":{"state":{"enum":["discovered","registered","composed","internal_proof","pilot_ready","customer_validated","repeatable","economically_proven","scale_ready"]},"operational_flags":{"type":"object","additionalProperties":false,"required":["routable","governable","executable","campaign_enabled","externally_validated","continuous_assurance_ready","revenue_proven"],"properties":{"routable":{"type":"boolean"},"governable":{"type":"boolean"},"executable":{"type":"boolean"},"campaign_enabled":{"type":"boolean"},"externally_validated":{"type":"boolean"},"continuous_assurance_ready":{"type":"boolean"},"revenue_proven":{"type":"boolean"}}}}},
    "notes":{"type":"string"}
  },
  "$defs":{"profileRef":{"type":"object","additionalProperties":false,"required":["profile_id","binding"],"properties":{"profile_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"binding":{"enum":["UNBOUND","BOUND"]},"version":{"type":"string","minLength":1},"content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"binding":{"const":"BOUND"}},"required":["binding"]},"then":{"required":["version","content_hash"]}}]}}
}
