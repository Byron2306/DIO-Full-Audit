{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.commercial_metabolism_final_receipt.v1",
  "title": "DIO M2 Commercial Metabolism Final Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "acceptance",
    "passed",
    "parent_phase",
    "parent_acceptance",
    "parent_verified",
    "reference_product",
    "gate_count",
    "passed_gate_count",
    "acceptance_gates",
    "phase_acceptances",
    "repeatability_adversary",
    "real_market_evidence",
    "real_payment_verified",
    "real_customer_acceptance_observed",
    "real_willingness_to_pay_proved",
    "commercial_validation_proved",
    "repeatability_proved",
    "commercial_success_required_for_metabolism_verification",
    "commercial_metabolism_verified",
    "content_transform_dataflow_proved",
    "m3_boundary_preserved",
    "authority_created",
    "authority_widened",
    "external_effects",
    "new_runtime_engine_created",
    "m1_verified",
    "m2_final_verified",
    "programme_complete",
    "final_gate_digest"
  ],
  "properties": {
    "schema": {"const": "dio.commercial_metabolism_final_receipt.v1"},
    "phase": {"const": "M2-9"},
    "acceptance": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "parent_phase": {"type": "string", "minLength": 1},
    "parent_acceptance": {"type": "string", "minLength": 1},
    "parent_verified": {"type": "boolean"},
    "reference_product": {"type": "string", "minLength": 1},
    "gate_count": {"type": "integer", "minimum": 0},
    "passed_gate_count": {"type": "integer", "minimum": 0},
    "acceptance_gates": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 16,
      "maxProperties": 16
    },
    "gate_evidence": {"type": "object"},
    "phase_acceptances": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "repeatability_adversary": {
      "type": "object",
      "required": ["case_count", "passed_case_count", "all_cases_passed", "cases", "controlled_replay_count", "distinct_replayed_truth_count", "same_fixture_replay_is_repeatability"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "passed_case_count": {"type": "integer", "minimum": 0},
        "all_cases_passed": {"type": "boolean"},
        "cases": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "controlled_replay_count": {"type": "integer", "minimum": 0},
        "distinct_replayed_truth_count": {"type": "integer", "minimum": 0},
        "same_fixture_replay_is_repeatability": {"type": "boolean"},
        "contract_refuses_underpowered_repeatability": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "real_market_evidence": {"type": "boolean"},
    "real_payment_verified": {"type": "boolean"},
    "real_customer_acceptance_observed": {"type": "boolean"},
    "real_willingness_to_pay_proved": {"type": "boolean"},
    "commercial_validation_proved": {"type": "boolean"},
    "repeatability_proved": {"type": "boolean"},
    "commercial_success_required_for_metabolism_verification": {"type": "boolean"},
    "commercial_success_proved": {"type": "boolean"},
    "commercial_metabolism_verified": {"type": "boolean"},
    "content_transform_dataflow_proved": {"type": "boolean"},
    "m3_boundary_preserved": {"type": "boolean"},
    "authority_created": {"type": "boolean"},
    "authority_widened": {"type": "boolean"},
    "external_effects": {"type": "boolean"},
    "new_runtime_engine_created": {"type": "boolean"},
    "m1_verified": {"type": "boolean"},
    "m2_final_verified": {"type": "boolean"},
    "programme_complete": {"type": "boolean"},
    "final_gate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
