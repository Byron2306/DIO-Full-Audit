    "units": [
      {
        "unit_id": "P1",
        "unit_type": "title",
        "source_text": "# Campaign Pack: HOMS Marking Relief Pack",
        "source_hash": "sha256:99e679cdb24d1fd41311152747a12084ab858522be3df83a8f12ba743a9a6bb3",
        "changed_from_previous": false
      },
      {
        "unit_id": "P2",
        "unit_type": "labelled_instruction",
        "source_text": "Job: `nichefoundry-ee2062916126d4976ae7` Created: 2026-08-07T14:41:55+00:00 Route confidence: 0.95",
        "source_hash": "sha256:6e174be785c5bf6c1d764fb1af5c108ea593cef9ad3d30a975990a01c70dad6b",
        "changed_from_previous": false
      },
      {
        "unit_id": "P3",
        "unit_type": "body",
        "source_text": "## Offer",
        "source_hash": "sha256:3e964323ef6dd4d09b5d23df934dd7132f4a2ea7ad65d23ba9ffa79fb0144898",
        "changed_from_previous": false
      },
      {
        "unit_id": "P4",
        "unit_type": "body",
        "source_text": "HOMS Marking Relief Pack",
        "source_hash": "sha256:6ce13e31ad588d14b6ca2547e5566276b1ccf1220165e587c5b7b18ce1a3008a",
        "changed_from_previous": false
      },
      {
        "unit_id": "P5",
        "unit_type": "body",
        "source_text": "## Core Angle",
        "source_hash": "sha256:4baf9e39d1e6adcadfd0af00e0f5146dadb9b600bfec36c9bca303d17818c6e6",
        "changed_from_previous": false
      },
      {
        "unit_id": "P6",
        "unit_type": "body",
        "source_text": "Messy operational input becomes a review-ready output pack. The client keeps judgment and approval.",
        "source_hash": "sha256:f29a8d81f3d2966a307bf020c6ca94e1f620c40c6d71ad714f8905c353a88f61",
        "changed_from_previous": false
      },
      {
        "unit_id": "P7",
        "unit_type": "body",
        "source_text": "## Target Buyer",
        "source_hash": "sha256:d3864badeecbfe9cd626e8d00b72dee8f41095c1d1f406ca698222dd3062e644",
        "changed_from_previous": false
      },
      {
        "unit_id": "P8",
        "unit_type": "instruction",
        "source_text": "- Busy lecturers, teachers, academic administrators, NGO operators, consultants, or evidence-heavy professionals. - They already have email threads, attachments, documents, rubrics, reports, and deadlines. - They do not want another abstract AI tool. They want a done-for-you workflow result.",
        "source_hash": "sha256:b867e4a30dc3adb35af0b3ae2647c9df4c51ba2248dfbc60634ce49906f84305",
        "changed_from_previous": false
      },
      {
        "unit_id": "P9",
        "unit_type": "body",
        "source_text": "## Lead Message",
        "source_hash": "sha256:23491e646b8f860795ad69879638322472429d50f1dab082e5ee96fcac2ceee4",
        "changed_from_previous": false
      },
      {
        "unit_id": "P10",
        "unit_type": "body",
        "source_text": "Send the messy batch. Get back a structured review pack.",
        "source_hash": "sha256:f7a350babf01dc604ce0cdc3062763e3343f41e4ab621147b73a845c93926f71",
        "changed_from_previous": false
      },
      {
        "unit_id": "P11",
        "unit_type": "body",
        "source_text": "## Source Brief",
        "source_hash": "sha256:de47605a5bb0f101ce7e20561a425183aa6eeb859b6853612bc870d3c305f431",
        "changed_from_previous": false
      },
      {
        "unit_id": "P12",
        "unit_type": "labelled_instruction",
        "source_text": "- Sender: founder@example.com - Subject: Need a campaign and lead magnet for academic marking support - Attachments: homs_offer_notes.pdf",
        "source_hash": "sha256:888de638de4eb555e065e356c4a6b5d8627fa1fd3166d23803550d6ebf3c17d4",
        "changed_from_previous": false
      },
      {
        "unit_id": "P13",
        "unit_type": "body",
        "source_text": "## Brief Extract",
        "source_hash": "sha256:232447137799461521f9af290ef65704f266a8fb9df0db38adb5a4c8fe312c3a",
        "changed_from_previous": false
      },
      {
        "unit_id": "P14",
        "unit_type": "body",
        "source_text": "Can you turn the HOMS marking relief offer into a landing page angle, LinkedIn posts, newsletter, and short video script for lecturers?",
        "source_hash": "sha256:36537d814f36408ef7cc97bc64caba9445b2887ed5fd90d0bcd8f92e2b8f1a55",
        "changed_from_previous": false
      },
      {
        "unit_id": "P15",
        "unit_type": "body",
        "source_text": "## Content Pieces",
        "source_hash": "sha256:b589b7e53417175410e4c000744a26d635284b1663d29af8dc0d04a81409b72e",
        "changed_from_previous": false
      },
      {
        "unit_id": "P16",
        "unit_type": "body",
        "source_text": "### 1. Pain Post",
        "source_hash": "sha256:53463fd5ce38184eaea2044163ebad45e7901823cb952a257121d9eea152b4d1",
        "changed_from_previous": false
      },
      {
        "unit_id": "P17",
        "unit_type": "instruction",
        "source_text": "You do not need another dashboard. You need the pile of emails, documents, rubrics, or evidence turned into something you can review and send.",
        "source_hash": "sha256:33f34d129df53930c4faee2822d2178940e1e00b873c59833eabd087c853afda",
        "changed_from_previous": false
      },
      {
        "unit_id": "P18",
        "unit_type": "body",
        "source_text": "### 2. Proof Post",
        "source_hash": "sha256:33c9a3f6d4adefa4fda37e940fa8ff19edccf94c72a09c8b44c0e0afb61e0916",
        "changed_from_previous": false
      },
      {
        "unit_id": "P19",
        "unit_type": "body",
        "source_text": "The workflow creates a job packet, preserves source evidence, routes it to the right product module, generates a review pack, and keeps the human approval gate intact.",
        "source_hash": "sha256:5919ea562aea5de660b3bdd6a38d1e7b4b9a40da98bfee382d329b89251053a9",
        "changed_from_previous": false
      },
      {
        "unit_id": "P20",
        "unit_type": "body",
        "source_text": "### 3. Offer Post",
        "source_hash": "sha256:7e82d96c875ec61831812ff123f82a158a08fe32b2efb31406ccc0d743c8a82f",
        "changed_from_previous": false
      },
      {
        "unit_id": "P21",
        "unit_type": "body",
        "source_text": "For a limited pilot, send one real but non-sensitive batch. We will return a review-ready pack and show exactly what the workflow can and cannot automate.",
        "source_hash": "sha256:cc2dc2e0ab83d77c05e6dde3a1d9bc93422034d87ad696609b6764e1c609e1bd",
        "changed_from_previous": false
      },
      {
        "unit_id": "P22",
        "unit_type": "body",
        "source_text": "### 4. Objection Post",
        "source_hash": "sha256:6ff77d579fa59343ae8ad63feeec4c20ca32c6e0217f233c50d06c028a95b425",
        "changed_from_previous": false
      },
      {
        "unit_id": "P23",
        "unit_type": "body",
        "source_text": "The system does not send emails, finalize marks, invent citations, or make HR decisions. It prepares the work so a human can decide faster.",
        "source_hash": "sha256:e746d06fa21d78d07ea072358d17dd49d95d50b3bff1eb1c96ad73a39bbfb750",
        "changed_from_previous": false
      },
      {
        "unit_id": "P24",
        "unit_type": "body",
        "source_text": "### 5. CTA",
        "source_hash": "sha256:0e2d7fc2b5a76e3bb18300fb2cc83e7e43b3d06426839226df7516034dea2d12",
        "changed_from_previous": false
      },
      {
        "unit_id": "P25",
        "unit_type": "labelled_instruction",
        "source_text": "Reply with the workflow you hate repeating: marking, evidence packs, performance reviews, inbox triage, or academic review.",
        "source_hash": "sha256:346409c4901d8bbe1355aba4710ea834213d3a0ec4f53acc2c8c6fe9f600b8b2",
        "changed_from_previous": false
      },
      {
        "unit_id": "P26",
        "unit_type": "body",
        "source_text": "## Short Video Script",
        "source_hash": "sha256:207124923162c6585cf65176020451dd2899bf64b55d2171f6180410340be56d",
        "changed_from_previous": false
      },
      {
        "unit_id": "P27",
        "unit_type": "labelled_instruction",
        "source_text": "Hook: \"This is what happens when an inbox stops being a graveyard and starts becoming a production line.\"",
        "source_hash": "sha256:57d2c8688c0a89722aec5eee23f4ad0a27fe433a61a1ffc72de8bb7439367542",
        "changed_from_previous": false
      },
      {
        "unit_id": "P28",
        "unit_type": "labelled_instruction",
        "source_text": "Scene 1: Show the messy input: email, ZIP, rubric, evidence folder, or brief.",
        "source_hash": "sha256:f15bc53387f8c59fdede96c4bafd9944ece68c0a33d921ad91697660f915cdd3",
        "changed_from_previous": false
      },
      {
        "unit_id": "P29",
        "unit_type": "labelled_instruction",
        "source_text": "Scene 2: Show route classification and job creation.",
        "source_hash": "sha256:cdefd53052ae893ebd0192866bd325ebe51d86951a582918142654a21e2f03a5",
        "changed_from_previous": false
      },
      {
        "unit_id": "P30",
        "unit_type": "labelled_instruction",
        "source_text": "Scene 3: Show the review pack: evidence manifest, checklist, draft, output folder.",
        "source_hash": "sha256:9ba0e70f29616891c957774eea40d66391895eea05c49902c1bdafda9d4b38ab",
        "changed_from_previous": false
      },
      {
        "unit_id": "P31",
        "unit_type": "labelled_instruction",
        "source_text": "Scene 4: Human approval stays in charge.",
        "source_hash": "sha256:d60809115a43688a8e9b95ee9e85fab026b004a270d4ea52be25155985e1b373",
        "changed_from_previous": false
      },
      {
        "unit_id": "P32",
        "unit_type": "labelled_instruction",
        "source_text": "CTA: \"Send one messy workflow. We will turn it into a review-ready pack.\"",
        "source_hash": "sha256:105d79e5ac29214d53d694dbf95f895d69b2a0b73ac3ed853b2e80b1092d2baa",
        "changed_from_previous": false
      },
      {
        "unit_id": "P33",
        "unit_type": "body",
        "source_text": "## Approval Checklist",
        "source_hash": "sha256:125e678ed808a2d07e6f13c0649f144c8e0b6246d91fa32923eea25145d478d8",
        "changed_from_previous": false
      },
      {
        "unit_id": "P34",
        "unit_type": "body",
        "source_text": "- [ ] No fake metrics. - [ ] No fabricated testimonials. - [ ] No claim that the system replaces professional judgment. - [ ] No automatic sending or final decisions implied. - [ ] CTA is concrete and low-friction.",
        "source_hash": "sha256:011c30dc045e6eeb1a4d69dc260c488ca6f992905d529de5aa05c3c76ecb7968",
        "changed_from_previous": false
      }
    ]
  },
