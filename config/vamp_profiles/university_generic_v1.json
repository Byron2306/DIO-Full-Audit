{
  "schema": "dio.performance_profile.v1",
  "profile_id": "university_generic_v1",
  "version": "1.0.0",
  "institution": {
    "name": "Institution-neutral university profile",
    "sector": "higher_education",
    "jurisdiction": "Unspecified"
  },
  "terminology": {
    "domain": "Performance domain",
    "objective": "Objective",
    "evidence": "Supporting evidence",
    "review_cycle": "Review cycle"
  },
  "domains": [
    {"code": "TEACHING", "label": "Teaching and Learning", "aliases": ["curriculum", "assessment", "student support"], "weight": null},
    {"code": "RESEARCH", "label": "Research and Innovation", "aliases": ["scholarship", "publication", "creative output"], "weight": null},
    {"code": "LEADERSHIP", "label": "Leadership and Administration", "aliases": ["management", "committee", "governance"], "weight": null},
    {"code": "ENGAGEMENT", "label": "Engagement and Service", "aliases": ["community", "industry", "professional service"], "weight": null},
    {"code": "DEVELOPMENT", "label": "Professional Development and Compliance", "aliases": ["training", "safety", "ethics"], "weight": null}
  ],
  "mapping_policy": {
    "stopwords": [
      "and", "the", "for", "with", "from", "this", "that", "into", "meeting", "meetings", "general",
      "activity", "progress", "project", "performance", "evidence", "objective", "review"
    ],
    "identifier_pattern": "(?i)\\b[A-Z]{2,8}[- ]?[0-9]{2,4}\\b",
    "human_assertion_precedence": true
  },
  "confidence_policy": {
    "acceptance_thresholds": {
      "retrieval": 0.7,
      "relevance": 0.75,
      "provenance": 0.8,
      "sufficiency": 0.65
    }
  },
  "evidence_policy": {
    "strong_source_cues": [
      "approved", "submitted", "accepted", "published", "minutes", "report", "moderation", "results",
      "attendance", "feedback", "completed", "certificate", "deliverable", "decision", "signed"
    ],
    "weak_source_cues": [
      "invitation", "invite", "reminder", "newsletter", "announcement", "save the date", "calendar",
      "agenda only", "vacancy", "call for papers"
    ],
    "deduplicate_by_hash": true
  },
  "rating_policy": {
    "enabled": false,
    "authoritative_rubric_required": true,
    "default_output": "evidence_coverage_only"
  }
}
