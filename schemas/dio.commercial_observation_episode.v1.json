{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dio.commercial_observation_episode.v1",
  "title": "DIO Commercial Observation Episode v1",
  "type": "object",
  "required": [
    "schema",
    "scenario_id",
    "outcome_class",
    "episode_plan_digest",
    "context_digest",
    "source_fixture_digest",
    "market_command_measurement_truth_digest",
    "market_observation_digest",
    "sensorium_episode_hash",
    "sensorium_event_ids",
    "controlled_fixture",
    "real_market_exposure_observed",
    "authority_created",
    "external_effects",
    "observation_truth_digest",
    "episode_evidence_digest"
  ],
  "properties": {
    "schema": {"const": "dio.commercial_observation_episode.v1"},
    "scenario_id": {"enum": ["positive_response", "negative_response", "no_response"]},
    "outcome_class": {"enum": ["POSITIVE_RESPONSE", "NEGATIVE_RESPONSE", "NO_RESPONSE"]},
    "episode_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_fixture_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "market_command_measurement_truth_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "market_observation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sensorium_episode_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sensorium_event_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "controlled_fixture": {"const": true},
    "real_market_exposure_observed": {"const": false},
    "payment_verified": {"const": false},
    "customer_acceptance_observed": {"const": false},
    "willingness_to_pay_proved": {"const": false},
    "commercial_validation_proved": {"const": false},
    "product_globally_invalidated": {"const": false},
    "authority_created": {"const": false},
    "external_effects": {"const": false},
    "observation_truth_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "episode_evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
