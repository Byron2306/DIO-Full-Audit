{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dio.local/schemas/semantic_content.schema.json",
  "title": "DIO Semantic Content",
  "type": "object",
  "required": ["schema", "object_id", "version", "title", "source_language", "context", "blocks"],
  "properties": {
    "schema": {"const": "dio.semantic_content.v1"},
    "object_id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "required": ["product", "artifact_type", "audience"],
      "properties": {
        "product": {"type": "string"},
        "artifact_type": {"type": "string"},
        "audience": {"type": "string"},
        "subject": {"type": "string"},
        "grade": {"type": ["string", "integer"]},
        "curriculum_concept": {"type": "string"}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "type"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["title", "heading", "paragraph", "learning_objective", "teacher_instruction", "learner_instruction", "question", "expected_response", "bullet_list", "table", "rubric", "figure", "diagram", "caption", "equation", "reference", "annexure", "page_break", "transcript"]},
          "text": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "marks": {"type": "number", "minimum": 0},
          "headers": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": ["string", "number"]}}},
          "items": {"type": "array", "items": {"type": "string"}},
          "media_path": {"type": "string"},
          "alt_text": {"type": "string"},
          "caption": {"type": "string"}
        }
      }
    },
    "translations": {"type": "object"}
  }
}
